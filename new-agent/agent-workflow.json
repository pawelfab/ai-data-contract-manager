{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python scripts/agent/session_context.py",
        "windows": "python scripts\\agent\\session_context.py",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python scripts/agent/security_guard.py",
        "windows": "python scripts\\agent\\security_guard.py",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/agent/stop_gate.py",
        "windows": "python scripts\\agent\\stop_gate.py",
        "timeout": 120
      }
    ]
  }
}
