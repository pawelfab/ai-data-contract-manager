# Skopiuj ten plik jako .env i uzupełnij klucz.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

ACDM_MODEL=openai:gpt-5.2
ACDM_CONTRACT_TRANSPORT=stdio
ACDM_MCP_TIMEOUT_SECONDS=15
ACDM_MAX_AUTOMATIC_REPAIR_ATTEMPTS=2
ACDM_HOST=127.0.0.1
ACDM_PORT=7932

# Append-only audit log: rozmowy, jawne thinking, tool calle, MCP i decision trace.
ACDM_AUDIT_ENABLED=true
ACDM_AUDIT_DIR=logs
ACDM_AUDIT_INCLUDE_MODEL_IO=true
ACDM_AUDIT_INCLUDE_MCP_PAYLOADS=true
