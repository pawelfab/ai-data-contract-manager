        {
          "name": "customer_id",
          "dataType": "STRING",
          "mode": "REQUIRED",
          "sourcePath": "source.columns.customer_id"
        },
        {
          "name": "balance",
          "dataType": "NUMERIC",
          "sourcePath": "source.columns.balance"
        },
        {
