{
  "version": "1.2",

  "presentation": {
    "@sourceSystem": {
      "displayName": "System źródłowy",
      "helpText": "Nazwa/identyfikator systemu źródłowego używany przez konfigurację, np. SAP lub Rocket."
    },

    "/metadata/version": {
      "displayName": "Wersja konfiguracji",
      "helpText": "Wersja konfiguracji w formacie SemVer, np. 1.0.0."
    },

    "/metadata/dataFileId": {
      "displayName": "Data File ID",
      "helpText": "Nazwa danych przetwarzanych przez zasilanie, używana m.in. do budowania ścieżek plików."
    },

    "/orchestration/schedule": {
      "displayName": "Harmonogram",
      "helpText": "Cron lub preset Airflow, np. @daily albo 0 7 * * *."
    },

    "/orchestration/startDate": {
      "displayName": "Data startu",
      "helpText": "Data startu DAG-a w formacie YYYY-MM-DD."
    },

    "/source/sourceType": {
      "displayName": "Typ źródła",
      "helpText": "Techniczny typ źródła danych: jdbc, json, txt lub fixed_width."
    }
  },

  "steps": [
    {
      "id": "source-system",
      "whenMissing": [
        "@sourceSystem"
      ],
      "expose": [
        "@sourceSystem"
      ]
    },

    {
      "id": "metadata",
      "whenPresent": [
        "@sourceSystem"
      ],
      "whenAnyMissing": [
        "/metadata/id",
        "/metadata/version",
        "/metadata/dataFileId"
      ],
      "expose": [
        "/metadata/id",
        "/metadata/version",
        "/metadata/dataFileId"
      ]
    },

    {
      "id": "orchestration",
      "whenPresent": [
        "@sourceSystem",
        "/metadata/id",
        "/metadata/version",
        "/metadata/dataFileId"
      ],
      "whenAnyMissing": [
        "/orchestration/schedule",
        "/orchestration/startDate"
      ],
      "expose": [
        "/orchestration/schedule",
        "/orchestration/startDate"
      ]
    },

    {
      "id": "source-type",
      "whenPresent": [
        "@sourceSystem",
        "/metadata/id",
        "/metadata/version",
        "/metadata/dataFileId",
        "/orchestration/schedule",
        "/orchestration/startDate"
      ],
      "whenAnyMissing": [
        "/source/sourceType"
      ],
      "expose": [
        "/source/sourceType"
      ]
    },

    {
      "id": "source-details",
      "whenPresent": [
        "/source/sourceType"
      ],
      "exposeMatchingSchemaRequirements": true
    }
  ]
}