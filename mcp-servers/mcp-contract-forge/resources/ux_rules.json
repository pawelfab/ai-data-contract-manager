{
  "version": "6",

  "rules": [
    {
      "id": "global.source_system.metadata_id",
      "scope": "global",
      "path": "/metadata/id",
      "value": "{/metadata/sourceSystemGcpId}",
      "when": {
        "path": "/metadata/sourceSystemGcpId",
        "exists": true
      },
      "priority": 100
    },

    {
      "id": "global.source_system.source_metadata",
      "scope": "global",
      "path": "/source/systemZrodlowy",
      "value": "{/metadata/sourceSystemGcpId}",
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 100
    },

    {
      "id": "global.activate_bronze",
      "scope": "global",
      "path": "/bronzeTable",
      "value": {},
      "when": [
        {"path": "/source/sourceType", "exists": true},
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": false}
      ],
      "priority": 50
    },

    {
      "id": "global.bronze_project",
      "scope": "global",
      "path": "/bronzeTable/table/project",
      "value": "{/metadata/sourceSystemGcpId}_bronze",
      "when": [
        {"path": "/source/sourceType", "exists": true},
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true}
      ],
      "priority": 100
    },

    {
      "id": "global.bronze_dataset",
      "scope": "global",
      "path": "/bronzeTable/table/dataset",
      "value": "{/metadata/sourceSystemGcpId}_bronze",
      "when": [
        {"path": "/source/sourceType", "exists": true},
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true}
      ],
      "priority": 100
    },

    {
      "id": "global.bronze_table",
      "scope": "global",
      "path": "/bronzeTable/table/table",
      "value": "{/metadata/sourceSystemGcpId}_bronze",
      "when": [
        {"path": "/source/sourceType", "exists": true},
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true}
      ],
      "priority": 100
    },

    {
      "id": "global.bronze_columns",
      "scope": "global",
      "path": "/bronzeTable/columns",
      "value": [],
      "when": [
        {"path": "/source/sourceType", "exists": true},
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true}
      ],
      "priority": 100
    },

    {
      "id": "global.enable_silver",
      "scope": "global",
      "path": "/silver/enabled",
      "value": true,
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true}
      ],
      "priority": 50
    },

    {
      "id": "global.enable_gold",
      "scope": "global",
      "path": "/gold/enabled",
      "value": true,
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true}
      ],
      "priority": 50
    },

    {
      "id": "global.silver_project",
      "scope": "global",
      "path": "/silver/tables/0/table/project",
      "value": "{/metadata/sourceSystemGcpId}_silver",
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true},
        {"path": "/silver/enabled", "equals": true}
      ],
      "priority": 100
    },

    {
      "id": "global.silver_dataset",
      "scope": "global",
      "path": "/silver/tables/0/table/dataset",
      "value": "{/metadata/sourceSystemGcpId}_silver",
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true},
        {"path": "/silver/enabled", "equals": true}
      ],
      "priority": 100
    },

    {
      "id": "global.silver_table",
      "scope": "global",
      "path": "/silver/tables/0/table/table",
      "value": "{/metadata/sourceSystemGcpId}_silver",
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true},
        {"path": "/silver/enabled", "equals": true}
      ],
      "priority": 100
    },

    {
      "id": "global.silver_source",
      "scope": "global",
      "path": "/silver/tables/0/source",
      "value": "{/metadata/sourceSystemGcpId}_bronze",
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true},
        {"path": "/silver/enabled", "equals": true}
      ],
      "priority": 100
    },

    {
      "id": "global.gold_project",
      "scope": "global",
      "path": "/gold/entries/0/table/project",
      "value": "{/metadata/sourceSystemGcpId}_gold",
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true},
        {"path": "/gold/enabled", "equals": true}
      ],
      "priority": 100
    },

    {
      "id": "global.gold_dataset",
      "scope": "global",
      "path": "/gold/entries/0/table/dataset",
      "value": "{/metadata/sourceSystemGcpId}_gold",
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true},
        {"path": "/gold/enabled", "equals": true}
      ],
      "priority": 100
    },

    {
      "id": "global.gold_table",
      "scope": "global",
      "path": "/gold/entries/0/table/table",
      "value": "{/metadata/sourceSystemGcpId}_gold",
      "when": [
        {"path": "/source", "requirementsComplete": true},
        {"path": "/bronzeTable", "exists": true},
        {"path": "/bronzeTable", "requirementsComplete": true},
        {"path": "/gold/enabled", "equals": true}
      ],
      "priority": 100
    },

    {
      "id": "sap.enable_converter",
      "scope": "system",
      "system": "sap",
      "path": "/converter/enabled",
      "value": true,
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 100
    },

    {
      "id": "sap.enable_preparator",
      "scope": "system",
      "system": "sap",
      "path": "/preparator/enabled",
      "value": true,
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 100
    }
  ]
}
