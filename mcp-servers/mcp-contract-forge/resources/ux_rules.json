{
  "version": "5",

  "rules": [
    {
      "id": "global.source_system.metadata_id",
      "scope": "global",
      "path": "/metadata/id",
      "value": "{/metadata/sourceSystemGcpId}",
      "when": {
        "path": "/metadata/sourceSystemGcpId",
        "exists": true
      },
      "priority": 100
    },

    {
      "id": "global.source_system.source_metadata",
      "scope": "global",
      "path": "/source/systemZrodlowy",
      "value": "{/metadata/sourceSystemGcpId}",
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 100
    },

    {
      "id": "global.enable_silver",
      "scope": "global",
      "path": "/silver/enabled",
      "value": true,
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 50
    },

    {
      "id": "global.enable_gold",
      "scope": "global",
      "path": "/gold/enabled",
      "value": true,
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 50
    },

    {
      "id": "sap.enable_converter",
      "scope": "system",
      "system": "sap",
      "path": "/converter/enabled",
      "value": true,
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 100
    },

    {
      "id": "sap.enable_preparator",
      "scope": "system",
      "system": "sap",
      "path": "/preparator/enabled",
      "value": true,
      "when": {
        "path": "/source/sourceType",
        "exists": true
      },
      "priority": 100
    },

    {
      "id": "sap.silver_dataset",
      "scope": "system",
      "system": "sap",
      "path": "/silver/tables/0/table/dataset",
      "value": "silver_sap",
      "priority": 110
    }
  ]
}