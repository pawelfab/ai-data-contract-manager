# Copy this file to .env. Process environment variables override values from .env.
ADCM_MCP_URL=http://127.0.0.1:8001/mcp

# Local OpenAI-compatible gateway (verified with the gateway's `auto` model).
ADCM_LLM_MODE=pydantic
ADCM_LLM_PROVIDER=openai_compatible
ADCM_MODEL=auto
ADCM_LLM_CONFIDENCE_THRESHOLD=0.80
OPENAI_BASE_URL=http://127.0.0.1:3030/v1
OPENAI_API_KEY=local-gateway

# Alternative Vertex configuration:
# ADCM_LLM_PROVIDER=vertex
# ADCM_VERTEX_MODEL=gemini-2.5-flash
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=europe-west1

ADCM_API_HOST=127.0.0.1
ADCM_API_PORT=8080
