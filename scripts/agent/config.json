{
  "source_roots": [
    "ai-data-contract-manager/src",
    "ai-data-contract-manager/pyproject.toml",
    "mcp-servers/mcp-contract-forge/src",
    "mcp-servers/mcp-contract-forge/resources",
    "mcp-servers/mcp-contract-forge/pyproject.toml"
  ],
  "source_extensions": [
    ".py",
    ".pyi",
    ".js",
    ".jsx",
    ".ts",
    ".tsx",
    ".java",
    ".kt",
    ".kts",
    ".cs",
    ".go",
    ".rs",
    ".php",
    ".rb",
    ".sql",
    ".graphql",
    ".proto",
    ".yaml",
    ".yml",
    ".json",
    ".toml"
  ],
  "exclude_dirs": [
    ".git",
    ".agent-state",
    ".venv",
    "venv",
    "node_modules",
    "dist",
    "build",
    "target",
    "coverage",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    "__pycache__",
    "docs/generated",
    ".github",
    ".vscode",
    "scripts/agent",
    "githooks"
  ],
  "architecture_docs_dir": "docs",
  "inventory_json": "docs/generated/repository-inventory.json",
  "repository_map": "docs/generated/repository-map.md",
  "documentation_impact_report": "docs/generated/documentation-impact.md",
  "freshness_file": "docs/.freshness.json",
  "session_state_dir": ".agent-state",
  "session_state_max_age_hours": 168,
  "documentation_relevant_patterns": [
    "^ai-data-contract-manager/(src/|pyproject\\.toml$)",
    "^mcp-servers/mcp-contract-forge/(src/|resources/|pyproject\\.toml$)"
  ],
  "documentation_evidence_patterns": [
    "^docs/(architecture|CURRENT_STATE|DECISIONS|service-boundaries|integration-flow|system-overview|documentation-automation)\\.md$",
    "^ai-data-contract-manager/docs/",
    "^mcp-servers/mcp-contract-forge/docs/"
  ],
  "documentation_non_evidence_patterns": [
    "^docs/generated/"
  ],
  "documentation_map": [
    {
      "source_pattern": "^ai-data-contract-manager/src/adcm/",
      "docs": [
        "docs/architecture.md",
        "docs/CURRENT_STATE.md",
        "ai-data-contract-manager/docs/"
      ]
    },
    {
      "source_pattern": "^ai-data-contract-manager/pyproject\\.toml$",
      "docs": [
        "docs/CURRENT_STATE.md"
      ]
    },
    {
      "source_pattern": "^mcp-servers/mcp-contract-forge/src/contract_forge/",
      "docs": [
        "docs/architecture.md",
        "docs/CURRENT_STATE.md",
        "mcp-servers/mcp-contract-forge/docs/"
      ]
    },
    {
      "source_pattern": "^mcp-servers/mcp-contract-forge/resources/",
      "docs": [
        "docs/CURRENT_STATE.md",
        "mcp-servers/mcp-contract-forge/docs/contract-format.md",
        "mcp-servers/mcp-contract-forge/docs/enrichment.md",
        "mcp-servers/mcp-contract-forge/docs/requirement-discovery.md"
      ]
    },
    {
      "source_pattern": "^(ai-data-contract-manager|mcp-servers/mcp-contract-forge)/pyproject\\.toml$",
      "docs": [
        "docs/architecture.md",
        "docs/CURRENT_STATE.md"
      ]
    }
  ],
  "quality_commands": {
    "format_check": [],
    "lint": [],
    "typecheck": [],
    "test": [
      "ai-data-contract-manager\\.venv\\Scripts\\python.exe -m pytest ai-data-contract-manager\\tests -q",
      "mcp-servers\\mcp-contract-forge\\.venv\\Scripts\\python.exe -m pytest mcp-servers\\mcp-contract-forge\\tests -q"
    ],
    "build": []
  },
  "pre_commit_quality_stages": [
    "format_check",
    "lint"
  ],
  "pre_push_quality_stages": [
    "typecheck",
    "test",
    "build"
  ],
  "stop_quality_stages": [],
  "strict_stop_gate": true,
  "require_docs_for_staged_relevant_code": true,
  "require_freshness_marker_for_staged_relevant_code": true,
  "protected_agent_paths": [
    ".github/hooks/",
    ".github/agents/",
    ".github/prompts/",
    ".github/copilot-instructions.md",
    ".codex/skills/",
    ".vscode/",
    "AGENTS.md",
    "scripts/agent/",
    "githooks/"
  ],
  "deny_command_patterns": [
    "(^|\\s)rm\\s+-rf\\s+[/~]",
    "git\\s+reset\\s+--hard",
    "git\\s+clean\\s+-[a-zA-Z]*f",
    "git\\s+push\\b.*(--force|-f)\\b",
    "\\bDROP\\s+(DATABASE|SCHEMA)\\b",
    "\\bTRUNCATE\\s+TABLE\\b",
    "\\bterraform\\s+destroy\\b",
    "\\bkubectl\\s+delete\\b.*\\b(namespace|ns)\\b"
  ],
  "approval_command_patterns": [
    "\\bDELETE\\s+FROM\\b",
    "\\bDROP\\s+TABLE\\b",
    "\\bdocker\\s+system\\s+prune\\b",
    "\\bhelm\\s+uninstall\\b",
    "\\bRemove-Item\\b(?=[^\\r\\n]*-Recurse\\b)",
    "\\b(?:rd|rmdir)\\b[^\\r\\n]*(?:/s|-s)\\b",
    "\\bdel\\b[^\\r\\n]*(?:/s|-s)\\b",
    "\\bgit\\s+restore\\b",
    "\\bgit\\s+checkout\\s+--(?:\\s|$)"
  ]
}
